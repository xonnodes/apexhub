install_cloudflared() {

    get_title

    echo -e "${BC}║${N}                  ☁️ INSTALL CLOUDFLARED                    ${BC}║${N}"
    echo -e "${BC}╠══════════════════════════════════════════════════════════════╣${N}"
    echo

    local arch
    arch="$(uname -m)"

    case "$arch" in
        x86_64)
            CLOUDFLARED_ARCH="amd64"
            ;;
        aarch64|arm64)
            CLOUDFLARED_ARCH="arm64"
            ;;
        armv7l)
            CLOUDFLARED_ARCH="arm"
            ;;
        *)
            error "Unsupported CPU architecture: $arch"
            pause
            return
            ;;
    esac

    info "Installing Cloudflared..."

    if curl -fL \
        "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${CLOUDFLARED_ARCH}" \
        -o /usr/local/bin/cloudflared; then

        chmod +x /usr/local/bin/cloudflared

        if command_exists cloudflared; then
            success "Cloudflared installed successfully."
        else
            error "Cloudflared installation failed."
        fi
    else
        error "Cloudflared download failed."
    fi

    pause
}

install_tailscale() {

    get_title

    echo -e "${BC}║${N}                   🔗 INSTALL TAILSCALE                     ${BC}║${N}"
    echo -e "${BC}╠══════════════════════════════════════════════════════════════╣${N}"
    echo

    info "Installing Tailscale..."

    if curl -fsSL https://tailscale.com/install.sh | sh; then

        systemctl enable --now tailscaled 2>/dev/null

        if systemctl is-active --quiet tailscaled; then
            success "Tailscale installed successfully."
            echo
            info "Run: tailscale up"
        else
            error "Tailscale installed but service is not running."
        fi

    else
        error "Tailscale installation failed."
    fi

    pause
}

uninstall_pterodactyl() {

    get_title

    echo -e "${BC}║${N}               🗑️ UNINSTALL PTERODACTYL                    ${BC}║${N}"
    echo -e "${BC}╠══════════════════════════════════════════════════════════════╣${N}"
    echo

    if [[ ! -d "$PANEL_DIR" ]]; then
        error "Pterodactyl Panel is not installed."
        pause
        return
    fi

    warning "This will remove the Pterodactyl Panel."
    echo
    echo "The following will be removed:"
    echo " - Pterodactyl Panel files"
    echo " - Pterodactyl queue worker"
    echo " - Pterodactyl cron"
    echo " - Pterodactyl Nginx configuration"
    echo " - Pterodactyl database"
    echo " - Pterodactyl database user"
    echo
    warning "This does NOT automatically remove Docker, PHP, MariaDB, Redis or Nginx."
    echo

    read -rp "Type UNINSTALL to continue ❯ " confirm

    if [[ "$confirm" != "UNINSTALL" ]]; then
        info "Uninstall cancelled."
        pause
        return
    fi

    echo
    info "Stopping Pterodactyl queue worker..."

    systemctl disable --now "$PANEL_SERVICE" 2>/dev/null || true

    rm -f "/etc/systemd/system/${PANEL_SERVICE}"
    systemctl daemon-reload
    systemctl reset-failed "$PANEL_SERVICE" 2>/dev/null || true

    echo
    info "Removing Pterodactyl cron..."

    rm -f /etc/cron.d/pterodactyl

    echo
    info "Removing Nginx configuration..."

    rm -f /etc/nginx/sites-enabled/pterodactyl.conf
    rm -f /etc/nginx/sites-available/pterodactyl.conf

    if nginx -t >/dev/null 2>&1; then
        systemctl reload nginx 2>/dev/null || true
    fi

    echo
    info "Removing Pterodactyl database..."

    if command_exists mysql; then

        mysql -u root <<'SQL'
DROP DATABASE IF EXISTS panel;
DROP USER IF EXISTS 'pterodactyl'@'127.0.0.1';
FLUSH PRIVILEGES;
SQL

    fi

    echo
    info "Removing Panel files..."

    rm -rf "$PANEL_DIR"

    echo

    if [[ ! -d "$PANEL_DIR" ]] &&
       [[ ! -f "/etc/systemd/system/${PANEL_SERVICE}" ]] &&
       [[ ! -f "/etc/cron.d/pterodactyl" ]] &&
       [[ ! -f "/etc/nginx/sites-available/pterodactyl.conf" ]]; then

        success "Pterodactyl Panel uninstalled successfully."

    else

        error "Pterodactyl uninstall completed with remaining files."

    fi

    pause
}

