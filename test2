delete_user() {
    get_title
    echo -e "${BC}║${N}                       🗑️ DELETE USER                         ${BC}║${N}"
    echo -e "${BC}╠══════════════════════════════════════════════════════════════╣${N}"
    echo

    if [[ ! -d "$PANEL_DIR" ]]; then
        error "Pterodactyl Panel is not installed."
        pause
        return
    fi

    read -rp " Enter User ID ❯ " user_id

    if [[ ! "$user_id" =~ ^[0-9]+$ ]]; then
        error "Invalid User ID."
        pause
        return
    fi

    warning "This permanently deletes user ID $user_id."
    read -rp " Continue? [y/N] ❯ " confirm

    [[ ! "$confirm" =~ ^[Yy]$ ]] && {
        info "Cancelled."
        pause
        return
    }

    cd "$PANEL_DIR" || return

    if php artisan tinker --execute="
\$user = App\Models\User::find($user_id);
if (\$user) {
    \$user->delete();
    echo 'DELETED';
} else {
    echo 'NOT_FOUND';
