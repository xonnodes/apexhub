        echo -e " ${W}[2]${N} 🗑️  Remove Blueprint"
        echo -e " ${W}[3]${N} 🔄 Change Blueprint"
        echo -e " ${W}[0]${N} ↩️  Back"
        echo

        read -rp " Select an option ❯ " choice

        case "$choice" in
            1) install_blueprint ;;
            2) remove_blueprint ;;
            3) change_blueprint ;;
            0) return ;;
            *) error "Invalid option."; sleep 1 ;;
        esac
    done
}

