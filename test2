    echo -e "${BC}╠══════════════════════════════════════════════════════════════╣${N}"
    echo

    if [[ ! -d "$PANEL_DIR" ]]; then
        error "Pterodactyl Panel is not installed."
        pause
        return
    fi

    if systemctl is-active --quiet nginx; then
        echo -e " Nginx       ${G}● Running${N}"
    else
        echo -e " Nginx       ${R}● Stopped${N}"
    fi

    if systemctl is-active --quiet mariadb; then
        echo -e " MariaDB     ${G}● Running${N}"
    else
        echo -e " MariaDB     ${R}● Stopped${N}"
    fi

    if systemctl is-active --quiet redis-server; then
        echo -e " Redis       ${G}● Running${N}"
    else
        echo -e " Redis       ${R}● Stopped${N}"
    fi

    if systemctl is-active --quiet php8.3-fpm; then
        echo -e " PHP-FPM     ${G}● Running${N}"
    else
        echo -e " PHP-FPM     ${R}● Stopped${N}"
    fi

    if systemctl is-active --quiet "$PANEL_SERVICE"; then
        echo -e " Queue       ${G}● Running${N}"
    else
        echo -e " Queue       ${R}● Stopped${N}"
    fi

    if nginx -t >/dev/null 2>&1; then
        echo -e " Nginx CFG   ${G}● Valid${N}"
    else
        echo -e " Nginx CFG   ${R}● Invalid${N}"
    fi

    pause
}

pterodactyl_information() {
    get_title
    echo -e "${BC}║${N}                  ℹ️ PANEL INFORMATION                      ${BC}║${N}"
    echo -e "${BC}╠══════════════════════════════════════════════════════════════╣${N}"
    echo

    if [[ ! -d "$PANEL_DIR" ]]; then
        error "Pterodactyl Panel is not installed."
        pause
        return
    fi

    cd "$PANEL_DIR" || return

    echo -e " ${C}Panel Path:${N}     $PANEL_DIR"

    if [[ -f .env ]]; then
        local app_url
        app_url="$(grep '^APP_URL=' .env | cut -d= -f2-)"
        echo -e " ${C}Panel URL:${N}      ${app_url:-Unknown}"
    fi

    if command_exists php; then
        echo -e " ${C}PHP:${N}            $(php -v | head -n1)"
    fi

    if command_exists composer; then
        echo -e " ${C}Composer:${N}       $(composer --version 2>/dev/null | head -n1)"
    fi

    echo
    echo -e " ${C}Services:${N}"

    systemctl is-active --quiet nginx \
        && echo -e "  ${G}✓${N} Nginx" \
        || echo -e "  ${R}✗${N} Nginx"

    systemctl is-active --quiet mariadb \
        && echo -e "  ${G}✓${N} MariaDB" \
        || echo -e "  ${R}✗${N} MariaDB"

    systemctl is-active --quiet redis-server \
        && echo -e "  ${G}✓${N} Redis" \
        || echo -e "  ${R}✗${N} Redis"

    systemctl is-active --quiet "$PANEL_SERVICE" \
        && echo -e "  ${G}✓${N} Queue Worker" \
        || echo -e "  ${R}✗${N} Queue Worker"

    pause
}

