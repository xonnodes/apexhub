# ---------------- HELPERS ----------------

pause() {
    echo
    read -rp " Press Enter to continue..." _
}

success() {
    echo -e "${G}[✓]${N} $1"
}

error() {
    echo -e "${R}[✗]${N} $1"
}

info() {
    echo -e "${C}[i]${N} $1"
}

warning() {
    echo -e "${Y}[!]${N} $1"
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

get_title() {
    clear
    echo -e "${BC}╔══════════════════════════════════════════════════════════════╗${N}"
