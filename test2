install_composer() {

    if command_exists composer; then
        success "Composer already installed."
        return 0
    fi

    info "Installing Composer..."

    if curl -fsSL https://getcomposer.org/installer | php \
        -- --install-dir=/usr/local/bin --filename=composer; then

        chmod +x /usr/local/bin/composer
        success "Composer installed."
        return 0
    fi

    error "Composer installation failed."
    return 1
}

install_pterodactyl() {

    get_title
    echo -e "${BC}║${N}                📦 INSTALL PTERODACTYL PANEL                ${BC}║${N}"
    echo -e "${BC}╠══════════════════════════════════════════════════════════════╣${N}"
    echo

    if [[ -d "$PANEL_DIR" ]]; then
        error "Pterodactyl is already installed."
        pause
        return
    fi

    if [[ ! -f /etc/os-release ]]; then
        error "Unable to detect operating system."
        pause
        return
    fi

    . /etc/os-release

    if [[ "$ID" != "ubuntu" ]]; then
        error "This installer currently supports Ubuntu only."
        pause
        return
    fi

    echo -e "${C}Pterodactyl Panel setup${N}"
    echo

    read -rp " Panel domain/FQDN ❯ " PANEL_DOMAIN

    if [[ -z "$PANEL_DOMAIN" ]]; then
        error "Panel domain is required."
        pause
        return
    fi

    echo
    warning "The Panel installer will install PHP, Nginx, MariaDB, Redis and Composer."
    read -rp " Continue? [y/N] ❯ " confirm

    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        info "Installation cancelled."
        pause
        return
    fi

    echo
    info "Updating package lists..."

    if ! apt-get update; then
        error "APT update failed."
        pause
        return
    fi

    echo
    info "Installing required packages..."

    local packages=(
        ca-certificates
        curl
        tar
        unzip
        git
        nginx
        mariadb-server
        redis-server
        php8.3
        php8.3-cli
        php8.3-fpm
        php8.3-gd
        php8.3-mysql
        php8.3-mbstring
        php8.3-bcmath
        php8.3-xml
        php8.3-curl
        php8.3-zip
        php8.3-opcache
        php8.3-tokenizer
    )

    if ! DEBIAN_FRONTEND=noninteractive apt-get install -y "${packages[@]}"; then
        error "Required package installation failed."
        pause
        return
    fi

    echo
    info "Enabling required services..."

    systemctl enable --now mariadb
    systemctl enable --now redis-server
    systemctl enable --now php8.3-fpm
    systemctl enable --now nginx

    if ! systemctl is-active --quiet mariadb; then
        error "MariaDB failed to start."
        pause
        return
    fi

    if ! systemctl is-active --quiet redis-server; then
        error "Redis failed to start."
        pause
        return
    fi

    if ! systemctl is-active --quiet php8.3-fpm; then
        error "PHP-FPM failed to start."
        pause
        return
    fi

    echo
    info "Creating Pterodactyl database..."

    local DB_PASSWORD

    DB_PASSWORD="$(openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 24)"

    if ! mysql -u root <<SQL
CREATE DATABASE IF NOT EXISTS panel;
CREATE USER IF NOT EXISTS 'pterodactyl'@'127.0.0.1' IDENTIFIED BY '${DB_PASSWORD}';
ALTER USER 'pterodactyl'@'127.0.0.1' IDENTIFIED BY '${DB_PASSWORD}';
GRANT ALL PRIVILEGES ON panel.* TO 'pterodactyl'@'127.0.0.1';
FLUSH PRIVILEGES;
SQL
    then
        error "MariaDB configuration failed."
        pause
        return
    fi

    success "Database configured."

    echo
    info "Downloading Pterodactyl Panel..."

    mkdir -p "$PANEL_DIR"
    cd "$PANEL_DIR" || return

    if ! curl -fLo panel.tar.gz \
        https://github.com/pterodactyl/panel/releases/latest/download/panel.tar.gz; then

        error "Pterodactyl Panel download failed."
        rm -rf "$PANEL_DIR"
        pause
        return
    fi

    if ! tar -xzf panel.tar.gz; then
        error "Pterodactyl archive extraction failed."
        rm -rf "$PANEL_DIR"
        pause
        return
    fi

    rm -f panel.tar.gz

    chmod -R 755 storage bootstrap/cache

    echo
    if ! install_composer; then
        error "Composer setup failed."
        pause
        return
    fi

    echo
    info "Installing PHP dependencies..."

    export COMPOSER_ALLOW_SUPERUSER=1

    if ! composer install --no-dev --optimize-autoloader --no-interaction; then
        error "Composer dependency installation failed."
        pause
        return
    fi

    echo
    info "Creating environment file..."

    cp .env.example .env

    if ! php artisan key:generate --force; then
        error "Application key generation failed."
        pause
        return
    fi

    echo
    info "Configuring Panel environment..."

    # Pterodactyl's official environment command is interactive.
    # The user completes the Panel-specific prompts here.
    if ! php artisan p:environment:setup; then
        error "Panel environment setup failed."
        pause
        return
    fi

    echo
    info "Configuring Panel database..."

    if ! php artisan p:environment:database; then
        error "Panel database configuration failed."
        pause
        return
    fi

    echo
    info "Configuring Panel mail..."

    if ! php artisan p:environment:mail; then
        error "Panel mail configuration failed."
        pause
        return
    fi

    echo
    info "Running database migrations..."

    if ! php artisan migrate --seed --force; then
        error "Database migration failed."
        pause
        return
    fi

    echo
    info "Setting Panel permissions..."

    chown -R www-data:www-data "$PANEL_DIR"

    echo
    info "Creating scheduler..."

    rm -f /etc/cron.d/pterodactyl

    cat > /etc/cron.d/pterodactyl <<EOF
* * * * * www-data php ${PANEL_DIR}/artisan schedule:run >> /dev/null 2>&1
EOF

    chmod 644 /etc/cron.d/pterodactyl

    echo
    info "Creating queue worker..."

    cat > "/etc/systemd/system/${PANEL_SERVICE}" <<EOF
[Unit]
Description=Pterodactyl Queue Worker
After=redis-server.service
Requires=redis-server.service

[Service]
User=www-data
Group=www-data
Restart=always
ExecStart=/usr/bin/php ${PANEL_DIR}/artisan queue:work --queue=high,standard,low --sleep=3 --tries=3
StartLimitInterval=180
StartLimitBurst=30
RestartSec=5s

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload

    if ! systemctl enable --now "$PANEL_SERVICE"; then
        error "Pterodactyl queue worker failed to start."
        systemctl status "$PANEL_SERVICE" --no-pager
        pause
        return
    fi

    echo
    info "Configuring Nginx..."

    rm -f /etc/nginx/sites-enabled/default
    rm -f /etc/nginx/sites-enabled/pterodactyl.conf

    cat > /etc/nginx/sites-available/pterodactyl.conf <<EOF
server {
    listen 80;
    listen [::]:80;

    server_name ${PANEL_DOMAIN};

    root ${PANEL_DIR}/public;
    index index.php;

    access_log /var/log/nginx/pterodactyl.app-access.log;
    error_log /var/log/nginx/pterodactyl.app-error.log error;

    client_max_body_size 100m;
    client_body_timeout 120s;

    sendfile off;

    location / {
        try_files \$uri \$uri/ /index.php?\$query_string;
    }

    location ~ \.php$ {
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_index index.php;

        include fastcgi_params;

        fastcgi_param PHP_VALUE "upload_max_filesize = 100M \n post_max_size=100M";
        fastcgi_param SCRIPT_FILENAME \$document_root\$fastcgi_script_name;
        fastcgi_param HTTP_PROXY "";

        fastcgi_intercept_errors off;
        fastcgi_buffer_size 16k;
        fastcgi_buffers 4 16k;
        fastcgi_connect_timeout 300;
        fastcgi_send_timeout 300;
        fastcgi_read_timeout 300;

        include /etc/nginx/fastcgi_params;
    }

    location ~ /\.ht {
        deny all;
    }
}
EOF

    ln -sf \
        /etc/nginx/sites-available/pterodactyl.conf \
        /etc/nginx/sites-enabled/pterodactyl.conf

    if ! nginx -t; then
        error "Nginx configuration test failed."
        nginx -t
        pause
        return
    fi

    if ! systemctl restart nginx; then
        error "Nginx failed to restart."
        pause
        return
    fi

    echo
    info "Creating first administrator..."

    cd "$PANEL_DIR" || return

    if ! php artisan p:user:make; then
        error "Administrator creation failed."
        pause
        return
    fi

    echo
    info "Running final checks..."

    local failed=0

    if systemctl is-active --quiet nginx; then
        success "Nginx is running."
    else
        error "Nginx is not running."
        failed=1
    fi

    if systemctl is-active --quiet mariadb; then
        success "MariaDB is running."
    else
        error "MariaDB is not running."
        failed=1
    fi

    if systemctl is-active --quiet redis-server; then
        success "Redis is running."
    else
        error "Redis is not running."
        failed=1
    fi

    if systemctl is-active --quiet php8.3-fpm; then
        success "PHP-FPM is running."
    else
        error "PHP-FPM is not running."
        failed=1
    fi

    if systemctl is-active --quiet "$PANEL_SERVICE"; then
        success "Pterodactyl queue worker is running."
    else
        error "Pterodactyl queue worker is not running."
        failed=1
    fi

    if [[ -f "$PANEL_DIR/.env" ]]; then
        success "Pterodactyl configuration exists."
    else
        error "Pterodactyl .env file is missing."
        failed=1
    fi

    echo

    if [[ "$failed" -eq 0 ]]; then
        success "Pterodactyl Panel installed successfully."
        echo
        echo -e " ${C}Panel URL:${N} http://${PANEL_DOMAIN}"
        echo
        warning "The database password was generated automatically."
        info "Database: panel"
        info "Database user: pterodactyl"
        info "Database password: ${DB_PASSWORD}"
        echo
        warning "Save the database password somewhere secure."
    else
        error "Installation completed with errors."
        info "Check the service status before using the Panel."
    fi

    pause
}

