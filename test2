install_blueprint() {
    get_title
    echo -e "${BC}║${N}                    📥 INSTALL BLUEPRINT                     ${BC}║${N}"
    echo -e "${BC}╠══════════════════════════════════════════════════════════════╣${N}"
    echo

    if ! command_exists blueprint; then
        error "Blueprint CLI is not installed."
        pause
        return
    fi

    local tmpdir="/tmp/apex-blueprints"

    rm -rf "$tmpdir"
    mkdir -p "$tmpdir"

    local failed=0

    info "Installing Blueprint extensions..."
    echo

    for file in "${BLUEPRINT_NAMES[@]}"; do
        echo -ne " ${file} ... "

        if curl -fsSL "${BLUEPRINT_URL}/${file}" -o "${tmpdir}/${file}"; then
            if blueprint -i "${tmpdir}/${file}" >/tmp/apex_blueprint_install.log 2>&1; then
                echo -e "${G}OK${N}"
            else
                echo -e "${R}FAILED${N}"
                failed=1
            fi
        else
            echo -e "${R}DOWNLOAD FAILED${N}"
            failed=1
        fi
    done

    rm -rf "$tmpdir"

    echo

    if [[ "$failed" -eq 0 ]]; then
        success "All Blueprint extensions installed successfully."
    else
        error "Some Blueprint extensions failed."
    fi

    pause
}

remove_blueprint() {
    get_title
    echo -e "${BC}║${N}                     🗑️ REMOVE BLUEPRINT                     ${BC}║${N}"
    echo -e "${BC}╠══════════════════════════════════════════════════════════════╣${N}"
    echo

    if ! command_exists blueprint; then
        error "Blueprint CLI is not installed."
        pause
        return
    fi

    read -rp " Enter Blueprint filename ❯ " file

    [[ "$file" != *.blueprint ]] && file="${file}.blueprint"

    if [[ -z "$file" ]]; then
        error "No Blueprint specified."
        pause
        return
    fi

    warning "This will remove $file"
    read -rp " Continue? [y/N] ❯ " confirm

    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        info "Cancelled."
        pause
        return
    fi

    if blueprint -r "${file%.blueprint}" >/tmp/apex_blueprint_remove.log 2>&1; then
        success "Blueprint removed successfully."
    else
        error "Blueprint removal failed."
        cat /tmp/apex_blueprint_remove.log
    fi

    pause
}

change_blueprint() {
    get_title
    echo -e "${BC}║${N}                    🔄 CHANGE BLUEPRINT                      ${BC}║${N}"
    echo -e "${BC}╠══════════════════════════════════════════════════════════════╣${N}"
    echo

    if ! command_exists blueprint; then
        error "Blueprint CLI is not installed."
        pause
        return
    fi

    read -rp " Enter Blueprint filename ❯ " file
    read -rp " Enter Blueprint URL ❯ " url

    if [[ -z "$file" || -z "$url" ]]; then
        error "Filename and URL are required."
        pause
        return
    fi

    [[ "$file" != *.blueprint ]] && file="${file}.blueprint"

    local tmp="/tmp/$file"

    if ! curl -fsSL "$url" -o "$tmp"; then
        error "Blueprint download failed."
        rm -f "$tmp"
        pause
        return
    fi

    if blueprint -i "$tmp" >/tmp/apex_blueprint_change.log 2>&1; then
        success "Blueprint installed successfully."
    else
        error "Blueprint installation failed."
        cat /tmp/apex_blueprint_change.log
    fi

    rm -f "$tmp"
    pause
}

blueprint_menu() {
    while true; do
        get_title
        echo -e "${BC}║${N}                 📦 BLUEPRINT / EXTENSION                    ${BC}║${N}"
        echo -e "${BC}╠══════════════════════════════════════════════════════════════╣${N}"
