# ============================================================
# SERVER INFORMATION HELPERS
# ============================================================

get_public_ipv4() {
    local ip=""

    ip=$(curl -4 -fsS --max-time 5 https://api.ipify.org 2>/dev/null)

    if [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
        echo "$ip"
    else
        echo "No IPv4 address"
    fi
}

get_public_ipv6() {
    local ip=""

    ip=$(curl -6 -fsS --max-time 5 https://api6.ipify.org 2>/dev/null)

    if [[ "$ip" == *:* ]]; then
        echo "$ip"
    else
        echo "No IPv6 address"
    fi
}

get_private_ipv4() {
    local ip

    ip=$(
        ip -4 addr show scope global 2>/dev/null |
        awk '/inet / {
            split($2,a,"/");
            if (
                a[1] ~ /^10\./ ||
                a[1] ~ /^192\.168\./ ||
                a[1] ~ /^172\.(1[6-9]|2[0-9]|3[0-1])\./
            ) {
                print a[1];
                exit
            }
        }'
    )

    if [[ -n "$ip" ]]; then
        echo "$ip"
    else
        echo "No private IP"
    fi
}

get_ip_type() {
    local public_ip="$1"

    if [[ "$public_ip" == "No IPv4 address" ]]; then
        echo "Unknown"
        return
    fi

    local route_ip
    route_ip=$(ip route get 1.1.1.1 2>/dev/null | awk '/src/ {for(i=1;i<=NF;i++) if($i=="src") print $(i+1)}')

    if [[ -z "$route_ip" ]]; then
        echo "Unknown"
        return
    fi

    # A local server cannot reliably prove whether an assigned
    # public IP is dedicated or shared. Avoid false claims.
    echo "Unknown"
}

# ============================================================
# SERVER INFORMATION
# ============================================================

server_information() {
    header "🖥️ SERVER INFORMATION"

    detect_os

    local hostname
    local cpu
    local cores
    local ram
    local disk
    local uptime
    local load
    local ipv4
    local private_ip
    local ipv6
    local ip_type

    hostname=$(hostname 2>/dev/null || echo "Unknown")
    cpu=$(lscpu 2>/dev/null | awk -F: '/Model name/ {gsub(/^[ \t]+/,"",$2); print $2; exit}')
    cores=$(nproc 2>/dev/null || echo "Unknown")
    ram=$(free -h 2>/dev/null | awk '/^Mem:/ {print $2}')
    disk=$(df -h / 2>/dev/null | awk 'NR==2 {print $2}')
    uptime=$(uptime -p 2>/dev/null || echo "Unknown")
    load=$(awk '{print $1" "$2" "$3}' /proc/loadavg 2>/dev/null)

    [[ -z "$cpu" ]] && cpu="Unknown"
    [[ -z "$ram" ]] && ram="Unknown"
    [[ -z "$disk" ]] && disk="Unknown"
    [[ -z "$load" ]] && load="Unknown"

    ipv4=$(get_public_ipv4)
    private_ip=$(get_private_ipv4)
    ipv6=$(get_public_ipv6)
    ip_type=$(get_ip_type "$ipv4")

    echo
    echo -e "${BC} SYSTEM${N}"
    echo " ──────────────────────────────────────────────────────────"
    printf " Hostname       : %s\n" "$hostname"
    printf " Operating Sys  : %s\n" "${OS_NAME:-Unknown}"
    printf " Kernel         : %s\n" "$(uname -r)"
    printf " Uptime         : %s\n" "$uptime"

    echo
    echo -e "${BC} HARDWARE${N}"
    echo " ──────────────────────────────────────────────────────────"
    printf " CPU            : %s\n" "$cpu"
    printf " CPU Cores      : %s\n" "$cores"
    printf " RAM            : %s\n" "$ram"
    printf " Disk           : %s\n" "$disk"
    printf " Load Average   : %s\n" "$load"

    echo
    echo -e "${BC} NETWORK${N}"
    echo " ──────────────────────────────────────────────────────────"
    printf " IPv4 Address   : %s\n" "$ipv4"
    printf " Private IP     : %s\n" "$private_ip"
    printf " IPv6 Address   : %s\n" "$ipv6"
    printf " IP Type        : %s\n" "$ip_type"

    echo
    pause
}

