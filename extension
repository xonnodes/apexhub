ping_host() {
    local host="$1"

    if ping -c 4 -W 2 "$host"; then
        success "Ping completed."
    else
        error_msg "Ping failed."
    fi
}

dns_test() {
    header "🌍 DNS TEST"

    if command_exists dig; then
        dig +short google.com
    elif command_exists nslookup; then
        nslookup google.com
    else
        apt-get update -qq
        apt-get install -y dnsutils
        dig +short google.com
    fi

    pause
}

network_interfaces() {
    header "🔌 NETWORK INTERFACES"
    ip -br addr
    echo
    pause
}

routing_table() {
    header "🛣️ ROUTING TABLE"
    ip route
    echo
    pause
}

speed_test() {
    header "📥 DOWNLOAD SPEED TEST"

    if ! command_exists curl; then
        error_msg "curl is not installed."
        pause
        return
    fi

    echo
    info "Testing download speed..."
    echo

    curl -L -o /dev/null \
        --silent \
        --show-error \
        --write-out \
        "Speed: %{speed_download} bytes/sec\n" \
        https://speed.cloudflare.com/__down?bytes=10000000

    echo
    pause
}

full_network_diagnostic() {
    header "🔍 FULL NETWORK DIAGNOSTIC"

    echo
    echo -e "${BC}PUBLIC IPv4${N}"
    get_public_ipv4

    echo
    echo -e "${BC}PRIVATE IPv4${N}"
    get_private_ipv4

    echo
    echo -e "${BC}PUBLIC IPv6${N}"
    get_public_ipv6

    echo
    echo -e "${BC}INTERFACES${N}"
    ip -br addr

    echo
    echo -e "${BC}ROUTES${N}"
    ip route

    echo
    echo -e "${BC}CLOUDFLARE${N}"
    ping -c 4 -W 2 1.1.1.1

    echo
    echo -e "${BC}GOOGLE${N}"
    ping -c 4 -W 2 8.8.8.8

    echo
    pause
}

