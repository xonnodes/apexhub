        error_msg "Pterodactyl Panel is not installed."
        pause
        return
    fi

    cd "$PANEL_DIR" || return

    echo
    warning "Deleting a Pterodactyl user can affect their resources."
    echo

    read -rp "User email or UUID: " identifier

    if [[ -z "$identifier" ]]; then
        error_msg "No user specified."
        pause
        return
    fi

    echo
    read -rp "Type DELETE to confirm: " confirmation

    if [[ "$confirmation" != "DELETE" ]]; then
        info "Cancelled."
        pause
        return
    fi

    if php artisan p:user:delete "$identifier"; then
        success "User deleted successfully."
    else
        error_msg "User deletion failed."
    fi

    pause
}

