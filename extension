# ============================================================
# BLUEPRINT HELPERS
# ============================================================

blueprint_installed() {
    local name="${1%.blueprint}"

    [[ -d "$PANEL_DIR/storage/extensions/$name" ]]
}

install_blueprint() {
    local file="$1"

    if [[ ! -d "$PANEL_DIR" ]]; then
        error_msg "Pterodactyl Panel is not installed."
        return 1
    fi

    cd "$PANEL_DIR" || return 1

    echo
    info "Downloading $file..."

    if ! wget -q --show-progress "$BLUEPRINT_URL/$file" -O "$file"; then
        error_msg "Failed to download $file"
        rm -f "$file"
        return 1
    fi

    if [[ ! -s "$file" ]]; then
        error_msg "Downloaded file is empty."
        rm -f "$file"
        return 1
    fi

    if ! command_exists blueprint; then
        error_msg "Blueprint CLI is not installed."
        rm -f "$file"
        return 1
    fi

    echo
    info "Installing ${file%.blueprint}..."

    if yes | blueprint -i "$file"; then
        rm -f "$file"
        success "Blueprint installed successfully."
        return 0
    fi

    rm -f "$file"
    error_msg "Blueprint installation failed."
    return 1
}

remove_blueprint() {
    local file="$1"
    local name="${file%.blueprint}"

    if ! command_exists blueprint; then
        error_msg "Blueprint CLI is not installed."
        return 1
    fi

    echo
    warning "You are removing: $name"

    if ! confirm "Continue?"; then
        info "Cancelled."
        return 0
    fi

    if yes | blueprint -r "$name"; then
        success "Blueprint removed successfully."
    else
        error_msg "Blueprint removal failed."
    fi
}

choose_blueprint() {
    local action="$1"

    while true; do
        header "📦 SELECT BLUEPRINT"

        local i=1

        for file in "${names[@]}"; do
            local name="${file%.blueprint}"

            if blueprint_installed "$file"; then
                printf " ${BG}[%02d]${N} ${name} ${BG}● INSTALLED${N}\n" "$i"
            else
                printf " ${BY}[%02d]${N} ${name} ${R}○${N}\n" "$i"
            fi

            ((i++))
        done

        echo
        echo -e " ${BR}[0]${N} ↩️ Back"
        echo

        read -rp " Select Blueprint ❯ " choice

        if [[ "$choice" == "0" ]]; then
            return
        fi

        if [[ "$choice" =~ ^[0-9]+$ ]] &&
           (( choice >= 1 && choice <= ${#names[@]} )); then

            local file="${names[$((choice-1))]}"

            case "$action" in
                install)
                    install_blueprint "$file"
                    pause
                    ;;
                remove)
                    remove_blueprint "$file"
                    pause
                    ;;
                change)
                    if blueprint_installed "$file"; then
                        echo
                        warning "This will reinstall the selected Blueprint."
                        if confirm "Continue?"; then
                            remove_blueprint "$file"
                            install_blueprint "$file"
                        fi
                    else
                        install_blueprint "$file"
                    fi
                    pause
                    ;;
            esac
        else
            error_msg "Invalid Blueprint number."
            sleep 1
        fi
    done
}

# ============================================================
# BLUEPRINT MENU
