# ============================================================
# PTERODACTYL PANEL INSTALL
# ============================================================

install_panel() {
    header "📦 INSTALL PTERODACTYL PANEL"

    if [[ -d "$PANEL_DIR" ]]; then
        warning "Pterodactyl Panel directory already exists."
        return
    fi

    detect_os || {
        error_msg "Unable to detect operating system."
        pause
        return
    }

    case "$OS_ID" in
        ubuntu|debian)
            ;;
        *)
            error_msg "Supported operating systems: Ubuntu / Debian."
            pause
            return
            ;;
    esac

    echo
    info "Detected: $OS_NAME"
    echo

    read -rp "Panel domain (example.com): " PANEL_DOMAIN
    read -rp "Database name [panel]: " DB_NAME
    DB_NAME="${DB_NAME:-panel}"

    read -rp "Database user [pterodactyl]: " DB_USER
    DB_USER="${DB_USER:-pterodactyl}"

    read -rsp "Database password: " DB_PASS
    echo

    read -rp "Admin email: " ADMIN_EMAIL
    read -rp "Admin username: " ADMIN_USER
    read -rp "Admin first name: " ADMIN_FIRST
    read -rp "Admin last name: " ADMIN_LAST

    if [[ -z "$PANEL_DOMAIN" ||
          -z "$DB_PASS" ||
          -z "$ADMIN_EMAIL" ||
          -z "$ADMIN_USER" ]]; then
        error_msg "Required information is missing."
        pause
        return
    fi

    echo
    warning "This will install system packages and configure Pterodactyl."
    if ! confirm "Start installation?"; then
        info "Cancelled."
        pause
        return
    fi

    echo
    info "Updating package lists..."
    apt-get update || {
        error_msg "APT update failed."
        pause
        return
    }

    info "Installing required packages..."

    apt-get install -y \
        curl \
        wget \
        unzip \
        tar \
        git \
        nginx \
        mariadb-server \
        redis-server \
        certbot \
        python3-certbot-nginx \
        ca-certificates \
        apt-transport-https \
        software-properties-common \
        gnupg \
        lsb-release \
        php8.3 \
        php8.3-cli \
        php8.3-common \
        php8.3-mysql \
        php8.3-gd \
        php8.3-mbstring \
        php8.3-bcmath \
        php8.3-xml \
        php8.3-curl \
        php8.3-zip \
        php8.3-fpm \
        composer

    if [[ $? -ne 0 ]]; then
        error_msg "Required package installation failed."
        pause
        return
    fi

    systemctl enable --now mariadb
    systemctl enable --now redis-server
    systemctl enable --now nginx
    systemctl enable --now php8.3-fpm

    if ! systemctl is-active --quiet mariadb; then
        error_msg "MariaDB failed to start."
        pause
        return
    fi

    info "Configuring database..."

    mysql <<SQL
CREATE DATABASE IF NOT EXISTS \`${DB_NAME}\`;
CREATE USER IF NOT EXISTS '${DB_USER}'@'127.0.0.1' IDENTIFIED BY '${DB_PASS}';
GRANT ALL PRIVILEGES ON \`${DB_NAME}\`.* TO '${DB_USER}'@'127.0.0.1';
FLUSH PRIVILEGES;
SQL

    if [[ $? -ne 0 ]]; then
        error_msg "MariaDB configuration failed."
        pause
        return
    fi

    mkdir -p "$PANEL_DIR"

    info "Downloading Pterodactyl Panel..."

    RELEASE_URL="$(
        curl -fsSL \
        -H "Accept: application/vnd.github+json" \
        "https://api.github.com/repos/pterodactyl/panel/releases/latest" |
        grep -m1 '"tarball_url"' |
        cut -d '"' -f4
    )"

    if [[ -z "$RELEASE_URL" ]]; then
        error_msg "Could not determine the latest Pterodactyl release."
        pause
        return
    fi

    if ! curl -fsSL "$RELEASE_URL" -o /tmp/pterodactyl.tar.gz; then
        error_msg "Failed to download Pterodactyl."
        pause
        return
    fi

    rm -rf /tmp/pterodactyl-panel
    mkdir -p /tmp/pterodactyl-panel

    tar -xzf /tmp/pterodactyl.tar.gz \
        --strip-components=1 \
        -C /tmp/pterodactyl-panel

    cp -a /tmp/pterodactyl-panel/. "$PANEL_DIR/"

    cd "$PANEL_DIR" || return

    if [[ ! -f artisan ]]; then
        error_msg "Pterodactyl files were not installed correctly."
        pause
        return
    fi

    info "Installing PHP dependencies..."

    if ! composer install --no-dev --optimize-autoloader --no-interaction; then
        error_msg "Composer installation failed."
        pause
        return
    fi

    if [[ ! -f .env ]]; then
        cp .env.example .env
    fi

    php artisan key:generate --force

    php artisan p:environment:setup \
        --author="$ADMIN_EMAIL" \
        --url="https://$PANEL_DOMAIN" \
        --timezone="UTC" \
        --cache="redis" \
        --session="redis" \
        --queue="redis"

    php artisan p:environment:database \
        --host="127.0.0.1" \
        --port="3306" \
        --database="$DB_NAME" \
        --username="$DB_USER" \
        --password="$DB_PASS"

    if ! php artisan migrate --seed --force; then
        error_msg "Database migration failed."
        pause
        return
    fi

    chown -R www-data:www-data "$PANEL_DIR"

    find "$PANEL_DIR/storage" "$PANEL_DIR/bootstrap/cache" \
        -type d -exec chmod 755 {} \; 2>/dev/null

    cat > /etc/nginx/sites-available/pterodactyl.conf <<EOF
server {
    listen 80;
    server_name $PANEL_DOMAIN;

    root $PANEL_DIR/public;
    index index.php;

    client_max_body_size 100m;

    location / {
        try_files \$uri \$uri/ /index.php?\$query_string;
    }

    location ~ \.php$ {
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME \$document_root\$fastcgi_script_name;
    }

    location ~ /\.ht {
        deny all;
    }
}
EOF

    ln -sf \
        /etc/nginx/sites-available/pterodactyl.conf \
        /etc/nginx/sites-enabled/pterodactyl.conf

    rm -f /etc/nginx/sites-enabled/default

    if ! nginx -t; then
        error_msg "Nginx configuration failed."
        pause
        return
    fi

    systemctl reload nginx

    echo
    success "Pterodactyl Panel installed successfully."
    echo
    info "Panel: https://$PANEL_DOMAIN"
    warning "Create the first administrator with the User Manager."
    pause
}

# ============================================================
# WINGS INSTALL
# ============================================================

install_wings() {
    header "🪽 INSTALL WINGS"

    if command_exists wings; then
        warning "Wings is already installed."
        pause
        return
    fi

    echo
    warning "Docker and Wings will be installed."
    if ! confirm "Continue?"; then
        info "Cancelled."
        pause
        return
    fi

    apt-get update

    apt-get install -y \
        ca-certificates \
        curl \
        gnupg \
        lsb-release

    if ! command_exists docker; then
        info "Installing Docker..."

        curl -fsSL https://get.docker.com | sh

        if [[ $? -ne 0 ]]; then
            error_msg "Docker installation failed."
            pause
            return
        fi
    fi

    systemctl enable --now docker

    mkdir -p /etc/pterodactyl

    info "Downloading latest Wings release..."

    WINGS_URL="$(
        curl -fsSL \
        -H "Accept: application/vnd.github+json" \
        "https://api.github.com/repos/pterodactyl/wings/releases/latest" |
        grep -m1 '"browser_download_url".*linux_amd64' |
        cut -d '"' -f4
    )"

    if [[ -z "$WINGS_URL" ]]; then
        error_msg "Could not find Wings Linux AMD64 release."
        pause
        return
    fi

    curl -fsSL "$WINGS_URL" -o /usr/local/bin/wings

    if [[ ! -s /usr/local/bin/wings ]]; then
        error_msg "Wings download failed."
        rm -f /usr/local/bin/wings
        pause
        return
    fi

    chmod +x /usr/local/bin/wings

    cat > /etc/systemd/system/wings.service <<'EOF'
[Unit]
Description=Pterodactyl Wings Daemon
After=docker.service
Requires=docker.service

[Service]
User=root
WorkingDirectory=/etc/pterodactyl
LimitNOFILE=4096
PIDFile=/run/wings/daemon.pid
ExecStart=/usr/local/bin/wings
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
EOF

    mkdir -p /run/wings

    systemctl daemon-reload
    systemctl enable wings

    echo
    success "Wings installed successfully."
    warning "Create/configure the Wings node in Pterodactyl before starting Wings."
    echo
    info "Configuration file: /etc/pterodactyl/config.yml"

    pause
}

