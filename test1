            1) blueprint_menu ;;
            2) user_menu ;;
            3) server_information ;;
            4) network_menu ;;
            5) packages_menu ;;
            6) hub_information ;;
            7) quick_links ;;
            0)
                clear
                echo -e "${G}Thanks for using APEX CLOULD.${N}"
                exit 0
                ;;
            *)
                error "Invalid option."
                sleep 1
                ;;
        esac
    done
}

# ============================================================
#                         ROOT CHECK
# ============================================================

if [[ "$EUID" -ne 0 ]]; then
    echo -e "${R}[✗]${N} This script must be run as root."
    echo "Run it with sudo or as root."
    exit 1
fi

main_menu
