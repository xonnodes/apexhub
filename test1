server_information() {
    while true; do
        get_title
        echo -e "${BC}║${N}                    🖥️ SERVER INFORMATION                    ${BC}║${N}"
        echo -e "${BC}╠══════════════════════════════════════════════════════════════╣${N}"
        echo

        local hostname_value
        local os_value
        local kernel_value
        local cpu_value
        local cores_value
        local ram_value
        local disk_value
        local uptime_value
        local ipv4_value
        local private_ipv4
        local ipv6_value

        hostname_value="$(hostname 2>/dev/null || echo "Unknown")"

        if [[ -f /etc/os-release ]]; then
            os_value="$(. /etc/os-release && echo "$PRETTY_NAME")"
        else
            os_value="Unknown"
        fi

        kernel_value="$(uname -r 2>/dev/null || echo "Unknown")"

        cpu_value="$(lscpu 2>/dev/null | awk -F: '/Model name/ {gsub(/^[ \t]+/, "", $2); print $2; exit}')"
        [[ -z "$cpu_value" ]] && cpu_value="Unknown"

        cores_value="$(nproc 2>/dev/null || echo "Unknown")"

        ram_value="$(free -h 2>/dev/null | awk '/^Mem:/ {print $3 " / " $2}')"
        [[ -z "$ram_value" ]] && ram_value="Unknown"

        disk_value="$(df -h / 2>/dev/null | awk 'NR==2 {print $3 " / " $2 " (" $5 ")"}')"
        [[ -z "$disk_value" ]] && disk_value="Unknown"

        uptime_value="$(uptime -p 2>/dev/null || echo "Unknown")"

        ipv4_value="$(curl -4 -fsSL --max-time 5 https://api.ipify.org 2>/dev/null || echo "Unavailable")"

        private_ipv4="$(ip -4 addr 2>/dev/null | awk '/inet / && $2 !~ /^127\./ {
            split($2,a,"/");
            if (a[1] ~ /^10\./ ||
                a[1] ~ /^192\.168\./ ||
                a[1] ~ /^172\.(1[6-9]|2[0-9]|3[0-1])\./) {
                print a[1];
                exit
            }
        }')"

        [[ -z "$private_ipv4" ]] && private_ipv4="None detected"

        ipv6_value="$(curl -6 -fsSL --max-time 5 https://api64.ipify.org 2>/dev/null || echo "Unavailable")"

        echo -e " ${C}Hostname:${N}      $hostname_value"
        echo -e " ${C}OS:${N}            $os_value"
        echo -e " ${C}Kernel:${N}        $kernel_value"
        echo -e " ${C}CPU:${N}           $cpu_value"
        echo -e " ${C}CPU Cores:${N}     $cores_value"
        echo -e " ${C}RAM:${N}           $ram_value"
        echo -e " ${C}Disk:${N}          $disk_value"
        echo -e " ${C}Uptime:${N}        $uptime_value"
        echo -e " ${C}Public IPv4:${N}   $ipv4_value"
        echo -e " ${C}Private IPv4:${N}  $private_ipv4"
        echo -e " ${C}IPv6:${N}          $ipv6_value"

        echo
        echo -e " ${W}[0]${N} ↩️  Back"
        echo

        read -rp " Select an option ❯ " choice

        case "$choice" in
            0) return ;;
            *) error "Invalid option."; sleep 1 ;;
        esac
    done
}

