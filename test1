install_cloudflared() {
    get_title
    echo -e "${BC}║${N}                  ☁️ INSTALL CLOUDFLARED                    ${BC}║${N}"
    echo -e "${BC}╠══════════════════════════════════════════════════════════════╣${N}"
    echo

    local arch
    arch="$(uname -m)"

    case "$arch" in
        x86_64)
            CLOUDFLARED_ARCH="amd64"
            ;;
        aarch64|arm64)
            CLOUDFLARED_ARCH="arm64"
            ;;
        armv7l)
            CLOUDFLARED_ARCH="arm"
            ;;
        *)
            error "Unsupported CPU architecture: $arch"
            pause
            return
            ;;
    esac

    info "Installing Cloudflared..."

    if curl -fL \
        "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${CLOUDFLARED_ARCH}" \
        -o /usr/local/bin/cloudflared; then

        chmod +x /usr/local/bin/cloudflared

        if command_exists cloudflared; then
            success "Cloudflared installed successfully."
            cloudflared --version
        else
            error "Cloudflared installation failed."
        fi
    else
        error "Cloudflared download failed."
    fi

    pause
}

install_tailscale() {
    get_title
    echo -e "${BC}║${N}                   🔗 INSTALL TAILSCALE                     ${BC}║${N}"
    echo -e "${BC}╠══════════════════════════════════════════════════════════════╣${N}"
    echo

    info "Installing Tailscale..."
    echo

    if curl -fsSL https://tailscale.com/install.sh | sh; then
        systemctl enable --now tailscaled 2>/dev/null

        if systemctl is-active --quiet tailscaled; then
            success "Tailscale installed successfully."
            echo
            info "Run 'tailscale up' to connect this server."
        else
            error "Tailscale was installed but tailscaled is not running."
        fi
    else
        error "Tailscale installation failed."
    fi

    pause
}

