# ============================================================
# BLUEPRINT DISPLAY
# ============================================================

blueprint_name() {
    local index="$1"
    local name="${BLUEPRINT_NAMES[$index]}"
    echo "${name%.blueprint}"
}

show_blueprints() {
    local total=${#BLUEPRINT_NAMES[@]}
    local rows=$(( (total + 1) / 2 ))
    local i
    local left
    local right
    local left_num
    local right_num
    local left_name
    local right_name

    echo
    echo -e "${BOLD}${WHITE}SELECT A BLUEPRINT:${RESET}"
    echo

    for ((i=0; i<rows; i++)); do
        left=$((i * 2))
        right=$((left + 1))

        left_num=$((left + 1))
        left_name=$(blueprint_name "$left")

        printf " ${CYAN}%2d${RESET}  %-31s" "$left_num" "$left_name"

        if (( right < total )); then
            right_num=$((right + 1))
            right_name=$(blueprint_name "$right")
            printf " ${CYAN}%2d${RESET}  %-31s" "$right_num" "$right_name"
        fi

        echo
    done

    echo
    echo -e " ${RED}0${RESET}  Exit"
    echo
}

# ============================================================
# BLUEPRINT INSTALL
# ============================================================

install_blueprint() {
    clear_screen
    get_title
    echo -e "${WHITE}║${RESET}                  📥 INSTALL BLUEPRINT                   ${WHITE}║${RESET}"
    echo -e "${BLUE}╚══════════════════════════════════════════════════════════════╝${RESET}"

    if ! command_exists blueprint; then
        error_msg "Blueprint CLI is not installed."
        echo
        echo "Install Blueprint CLI first, then run this option again."
        pause
        return
    fi

    show_blueprints

    read -rp " 👉 Enter choice: " choice

    if [[ "$choice" == "0" ]]; then
        return
    fi

    if ! [[ "$choice" =~ ^[0-9]+$ ]]; then
        error_msg "Invalid selection."
        pause
        return
    fi

    if (( choice < 1 || choice > ${#BLUEPRINT_NAMES[@]} )); then
        error_msg "Invalid blueprint number."
        pause
        return
    fi

    local index=$((choice - 1))
    local file="${BLUEPRINT_NAMES[$index]}"
    local tmp="/tmp/$file"

    echo
    info "Selected: ${file}"
    echo
    info "Downloading blueprint..."

    if ! curl -fL --retry 3 -o "$tmp" "$BLUEPRINT_URL/$file"; then
        error_msg "Blueprint download failed."
        rm -f "$tmp"
        pause
        return
    fi

    echo
    info "Installing blueprint..."

    if blueprint -i "$tmp"; then
        success "Installation completed successfully."
        rm -f "$tmp"
    else
        error_msg "Installation failed."
        echo "Reason: Blueprint CLI returned an error."
        rm -f "$tmp"
    fi

    pause
}

# ============================================================
# BLUEPRINT REMOVE
# ============================================================

remove_blueprint() {
    clear_screen
    get_title
    echo -e "${WHITE}║${RESET}                   🗑️  REMOVE BLUEPRINT                   ${WHITE}║${RESET}"
    echo -e "${BLUE}╚══════════════════════════════════════════════════════════════╝${RESET}"

    if ! command_exists blueprint; then
        error_msg "Blueprint CLI is not installed."
        pause
        return
    fi

    show_blueprints

    read -rp " 👉 Enter choice: " choice

    if [[ "$choice" == "0" ]]; then
        return
    fi

    if ! [[ "$choice" =~ ^[0-9]+$ ]]; then
        error_msg "Invalid selection."
        pause
        return
    fi

    if (( choice < 1 || choice > ${#BLUEPRINT_NAMES[@]} )); then
        error_msg "Invalid blueprint number."
        pause
        return
    fi

    local index=$((choice - 1))
    local file="${BLUEPRINT_NAMES[$index]}"
    local blueprint_without_ext="${file%.blueprint}"

    echo
    warning "You are about to remove: $blueprint_without_ext"
    read -rp "Type YES to continue: " confirm

    if [[ "$confirm" != "YES" ]]; then
        info "Cancelled."
        pause
        return
    fi

    echo
    info "Removing blueprint..."

    if blueprint -r "$blueprint_without_ext"; then
        success "Blueprint removed successfully."
    else
        error_msg "Removal failed."
        echo "Reason: Blueprint CLI returned an error."
    fi

    pause
}

