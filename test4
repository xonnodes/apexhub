# ============================================================
# PTERODACTYL UNINSTALL
# ============================================================

uninstall_pterodactyl() {
    clear_screen
    get_title
    echo -e "${WHITE}║${RESET}               🗑️  UNINSTALL PTERODACTYL                  ${WHITE}║${RESET}"
    echo -e "${BLUE}╚══════════════════════════════════════════════════════════════╝${RESET}"
    echo

    if [[ ! -d /var/www/pterodactyl ]]; then
        info "Pterodactyl Panel does not appear to be installed."
        pause
        return
    fi

    warning "This will remove:"
    echo "  • /var/www/pterodactyl"
    echo "  • Pterodactyl queue worker"
    echo "  • Pterodactyl cron"
    echo "  • Pterodactyl Nginx configuration"
    echo "  • Pterodactyl database"
    echo "  • Pterodactyl database user"
    echo
    warning "PHP, Nginx, MariaDB and Redis will NOT be removed."
    echo

    read -rp "Type UNINSTALL to continue: " CONFIRM

    if [[ "$CONFIRM" != "UNINSTALL" ]]; then
        info "Uninstall cancelled."
        pause
        return
    fi

    echo
    info "Stopping Pterodactyl queue..."

    systemctl disable --now pteroq 2>/dev/null || true

    rm -f /etc/systemd/system/pteroq.service
    systemctl daemon-reload

    echo
    info "Removing cron..."

    rm -f /etc/cron.d/pterodactyl

    echo
    info "Removing Nginx configuration..."

    rm -f /etc/nginx/sites-enabled/pterodactyl.conf
    rm -f /etc/nginx/sites-available/pterodactyl.conf

    nginx -t >/dev/null 2>&1 && systemctl reload nginx || true

    echo
    info "Removing database..."

    if mariadb <<'SQL'
DROP DATABASE IF EXISTS panel;
DROP USER IF EXISTS 'pterodactyl'@'127.0.0.1';
FLUSH PRIVILEGES;
SQL
    then
        success "Database removed."
    else
        error_msg "Database removal failed."
    fi

    echo
    info "Removing Panel files..."

    rm -rf /var/www/pterodactyl

    if [[ ! -d /var/www/pterodactyl ]]; then
        success "Pterodactyl files removed."
    else
        error_msg "Panel files could not be completely removed."
        pause
        return
    fi

    echo
    success "Pterodactyl Panel uninstalled successfully."

    pause
}

