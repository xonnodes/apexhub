# ============================================================
# BASIC FUNCTIONS
# ============================================================

pause() {
    echo
    read -rp "Press Enter to continue..."
}

clear_screen() {
    clear
}

success() {
    echo -e "${GREEN}[✓]${RESET} $1"
}

error_msg() {
