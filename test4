# ============================================================
# CLOUDFLARED
# ============================================================

install_cloudflared() {
    clear_screen
    get_title
    echo -e "${WHITE}║${RESET}                  ☁️  INSTALL CLOUDFLARED                  ${WHITE}║${RESET}"
    echo -e "${BLUE}╚══════════════════════════════════════════════════════════════╝${RESET}"
    echo

    if command_exists cloudflared; then
        warning "Cloudflared is already installed."
        cloudflared --version
        pause
        return
    fi

    local arch
    arch="$(uname -m)"

    case "$arch" in
        x86_64|amd64)
            CLOUDFLARED_ARCH="amd64"
            ;;
        aarch64|arm64)
            CLOUDFLARED_ARCH="arm64"
            ;;
        armv7l)
            CLOUDFLARED_ARCH="arm"
            ;;
        *)
            error_msg "Unsupported CPU architecture: $arch"
            pause
            return
            ;;
    esac

    info "Downloading Cloudflared..."

    if curl -fL \
        "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${CLOUDFLARED_ARCH}" \
        -o /usr/local/bin/cloudflared
    then
        chmod +x /usr/local/bin/cloudflared
        success "Cloudflared installed successfully."
        echo
        cloudflared --version
    else
        error_msg "Installation failed"
        echo "Reason: Cloudflared download failed."
    fi

    pause
}

install_tailscale() {
    clear_screen
    get_title
    echo -e "${WHITE}║${RESET}                   🔗 INSTALL TAILSCALE                    ${WHITE}║${RESET}"
    echo -e "${BLUE}╚══════════════════════════════════════════════════════════════╝${RESET}"
    echo

    if command_exists tailscale; then
        warning "Tailscale is already installed."
        tailscale version
        pause
        return
    fi

    info "Installing Tailscale..."

    if curl -fsSL https://tailscale.com/install.sh | sh; then
        systemctl enable --now tailscaled
        success "Tailscale installed successfully."
        echo
        info "Run 'tailscale up' to connect this server to your Tailnet."
    else
        error_msg "Installation failed"
        echo "Reason: Tailscale installer failed."
    fi

    pause
}

uninstall_cloudflared() {
    clear_screen
    get_title
    echo -e "${WHITE}║${RESET}                  🗑️  UNINSTALL CLOUDFLARED                ${WHITE}║${RESET}"
    echo -e "${BLUE}╚══════════════════════════════════════════════════════════════╝${RESET}"
    echo

    if [[ ! -f /usr/local/bin/cloudflared ]]; then
        info "Cloudflared is not installed."
        pause
        return
    fi

    read -rp "Type UNINSTALL to continue: " CONFIRM

    if [[ "$CONFIRM" != "UNINSTALL" ]]; then
        info "Cancelled."
        pause
        return
    fi

    systemctl disable --now cloudflared 2>/dev/null || true
    rm -f /usr/local/bin/cloudflared

    if [[ ! -f /usr/local/bin/cloudflared ]]; then
        success "Cloudflared uninstalled successfully."
    else
        error_msg "Cloudflared removal failed."
    fi

    pause
}

uninstall_tailscale() {
    clear_screen
    get_title
    echo -e "${WHITE}║${RESET}                   🗑️  UNINSTALL TAILSCALE                 ${WHITE}║${RESET}"
    echo -e "${BLUE}╚══════════════════════════════════════════════════════════════╝${RESET}"
    echo

    if ! command_exists tailscale; then
        info "Tailscale is not installed."
        pause
        return
    fi

    read -rp "Type UNINSTALL to continue: " CONFIRM

    if [[ "$CONFIRM" != "UNINSTALL" ]]; then
        info "Cancelled."
        pause
        return
    fi

    systemctl disable --now tailscaled 2>/dev/null || true

    if apt-get remove --purge -y tailscale; then
        success "Tailscale uninstalled successfully."
    else
        error_msg "Tailscale removal failed."
    fi

    pause
}

