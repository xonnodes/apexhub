server_information() {
    clear_screen
    get_title
    echo -e "${WHITE}║${RESET}                    🖥️  SERVER INFORMATION                 ${WHITE}║${RESET}"
    echo -e "${BLUE}╚══════════════════════════════════════════════════════════════╝${RESET}"
    echo

    local hostname_value
    local os_value
    local kernel_value
    local cpu_model
    local cpu_cores
    local ram_value
    local disk_value
    local uptime_value
    local public_ipv4
    local private_ipv4
    local public_ipv6

    hostname_value="$(hostname 2>/dev/null || echo "Unknown")"

    os_value="$(
        . /etc/os-release 2>/dev/null
        echo "${PRETTY_NAME:-Unknown}"
    )"

    kernel_value="$(uname -r 2>/dev/null || echo "Unknown")"

    cpu_model="$(
        lscpu 2>/dev/null |
        awk -F: '/Model name/ {gsub(/^[ \t]+/, "", $2); print $2; exit}'
    )"

    cpu_model="${cpu_model:-Unknown}"

    cpu_cores="$(
        nproc 2>/dev/null || echo "Unknown"
    )"

    ram_value="$(
        free -h 2>/dev/null |
        awk '/^Mem:/ {print $2}'
    )"

    ram_value="${ram_value:-Unknown}"

    disk_value="$(
        df -h / 2>/dev/null |
        awk 'NR==2 {print $2 " total / " $3 " used / " $4 " free"}'
    )"

    disk_value="${disk_value:-Unknown}"

    uptime_value="$(uptime -p 2>/dev/null || echo "Unknown")"

    public_ipv4="$(
        curl -4 -fsS --max-time 5 https://api.ipify.org 2>/dev/null ||
        echo "Unknown"
    )"

    private_ipv4="$(
        ip -4 addr 2>/dev/null |
        awk '/inet / {
            split($2,a,"/");
            if (a[1] ~ /^10\./ ||
                a[1] ~ /^192\.168\./ ||
                a[1] ~ /^172\.(1[6-9]|2[0-9]|3[0-1])\./) {
                print a[1];
                exit
            }
        }'
    )"

    private_ipv4="${private_ipv4:-None detected}"

    public_ipv6="$(
        curl -6 -fsS --max-time 5 https://api64.ipify.org 2>/dev/null ||
        echo "Unknown"
    )"

    echo -e "${CYAN}Hostname       :${RESET} $hostname_value"
    echo -e "${CYAN}OS             :${RESET} $os_value"
    echo -e "${CYAN}Kernel         :${RESET} $kernel_value"
    echo -e "${CYAN}CPU            :${RESET} $cpu_model"
    echo -e "${CYAN}CPU Cores      :${RESET} $cpu_cores"
    echo -e "${CYAN}RAM            :${RESET} $ram_value"
    echo -e "${CYAN}Disk           :${RESET} $disk_value"
    echo -e "${CYAN}Uptime         :${RESET} $uptime_value"
    echo -e "${CYAN}Public IPv4    :${RESET} $public_ipv4"
    echo -e "${CYAN}Private IPv4   :${RESET} $private_ipv4"
    echo -e "${CYAN}Public IPv6    :${RESET} $public_ipv6"
    echo -e "${CYAN}IP Type        :${RESET} Unknown / Not verified"

    echo
    pause
}

