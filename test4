# ============================================================
# PTERODACTYL INSTALL
# ============================================================

install_pterodactyl() {
    clear_screen
    get_title
    echo -e "${WHITE}║${RESET}                📦 INSTALL PTERODACTYL PANEL              ${WHITE}║${RESET}"
    echo -e "${BLUE}╚══════════════════════════════════════════════════════════════╝${RESET}"
    echo

    if [[ ! -f /etc/os-release ]]; then
        error_msg "Unable to detect operating system."
        pause
        return
    fi

    source /etc/os-release

    if [[ "${ID:-}" != "ubuntu" ]]; then
        error_msg "This installer currently supports Ubuntu only."
        pause
        return
    fi

    if [[ -d /var/www/pterodactyl && -f /var/www/pterodactyl/artisan ]]; then
        warning "Pterodactyl already appears to be installed."
        pause
        return
    fi

    read -rp "Enter Panel domain (example: panel.example.com): " PANEL_DOMAIN

    if [[ -z "$PANEL_DOMAIN" ]]; then
        error_msg "Domain cannot be empty."
        pause
        return
    fi

    echo
    warning "Pterodactyl installation will modify this server."
    read -rp "Type INSTALL to continue: " CONFIRM

    if [[ "$CONFIRM" != "INSTALL" ]]; then
        info "Installation cancelled."
        pause
        return
    fi

    echo
    info "Updating package lists..."

    if ! apt-get update; then
        error_msg "Installation failed"
        echo "Reason: apt update failed"
        pause
        return
    fi

    echo
    info "Installing required packages..."

    if ! DEBIAN_FRONTEND=noninteractive apt-get install -y \
        ca-certificates \
        curl \
        tar \
        unzip \
        git \
        nginx \
        mariadb-server \
        redis-server \
        php8.3 \
        php8.3-cli \
        php8.3-fpm \
        php8.3-gd \
        php8.3-mysql \
        php8.3-mbstring \
        php8.3-bcmath \
        php8.3-xml \
        php8.3-curl \
        php8.3-zip \
        php8.3-opcache \
        php8.3-tokenizer
    then
        error_msg "Installation failed"
        echo "Reason: Required packages could not be installed."
        pause
        return
    fi

    systemctl enable --now mariadb
    systemctl enable --now redis-server
    systemctl enable --now php8.3-fpm
    systemctl enable --now nginx

    echo
    info "Creating Pterodactyl database..."

    DB_PASSWORD="$(openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 28)"

    if ! mariadb <<SQL
CREATE DATABASE IF NOT EXISTS panel;
CREATE USER IF NOT EXISTS 'pterodactyl'@'127.0.0.1' IDENTIFIED BY '${DB_PASSWORD}';
ALTER USER 'pterodactyl'@'127.0.0.1' IDENTIFIED BY '${DB_PASSWORD}';
GRANT ALL PRIVILEGES ON panel.* TO 'pterodactyl'@'127.0.0.1';
FLUSH PRIVILEGES;
SQL
    then
        error_msg "Installation failed"
        echo "Reason: MariaDB configuration failed"
        pause
        return
    fi

    echo
    info "Downloading Pterodactyl Panel..."

    mkdir -p /var/www/pterodactyl
    cd /var/www/pterodactyl || return

    rm -f panel.tar.gz

    if ! curl -fLo panel.tar.gz \
        https://github.com/pterodactyl/panel/releases/latest/download/panel.tar.gz
    then
        error_msg "Installation failed"
        echo "Reason: Pterodactyl Panel download failed."
        pause
        return
    fi

    if ! tar -xzf panel.tar.gz; then
        error_msg "Installation failed"
        echo "Reason: Panel archive extraction failed."
        pause
        return
    fi

    rm -f panel.tar.gz

    chmod -R 755 storage bootstrap/cache 2>/dev/null || true

    echo
    info "Installing Composer..."

    if ! command_exists composer; then
        if ! curl -sS https://getcomposer.org/installer | \
            php -- --install-dir=/usr/local/bin --filename=composer
        then
            error_msg "Installation failed"
            echo "Reason: Composer installation failed."
            pause
            return
        fi
    fi

    echo
    info "Installing PHP dependencies..."

    if ! COMPOSER_ALLOW_SUPERUSER=1 composer install \
        --no-dev \
        --optimize-autoloader \
        --no-interaction
    then
        error_msg "Installation failed"
        echo "Reason: Composer dependency installation failed."
        pause
        return
    fi

    echo
    info "Creating environment file..."

    if ! cp .env.example .env; then
        error_msg "Installation failed"
        echo "Reason: Unable to create .env"
        pause
        return
    fi

    if ! php artisan key:generate --force; then
        error_msg "Installation failed"
        echo "Reason: Laravel application key generation failed."
        pause
        return
    fi

    echo
    info "Pterodactyl environment setup"
    echo "Follow the prompts shown below."
    echo

    if ! php artisan p:environment:setup; then
        error_msg "Installation failed"
        echo "Reason: Pterodactyl environment setup failed."
        pause
        return
    fi

    echo
    info "Configuring database..."

    if ! php artisan p:environment:database; then
        error_msg "Installation failed"
        echo "Reason: Pterodactyl database configuration failed."
        pause
        return
    fi

    echo
    info "Configuring mail..."

    if ! php artisan p:environment:mail; then
        error_msg "Installation failed"
        echo "Reason: Pterodactyl mail configuration failed."
        pause
        return
    fi

    echo
    info "Running database migrations..."

    if ! php artisan migrate --seed --force; then
        error_msg "Installation failed"
        echo "Reason: Database migration failed."
        pause
        return
    fi

    echo
    info "Setting permissions..."

    chown -R www-data:www-data /var/www/pterodactyl

    echo
    info "Creating Pterodactyl cron..."

    cat > /etc/cron.d/pterodactyl <<'EOF'
* * * * * www-data php /var/www/pterodactyl/artisan schedule:run >> /dev/null 2>&1
EOF

    chmod 644 /etc/cron.d/pterodactyl

    echo
    info "Creating queue worker..."

    cat > /etc/systemd/system/pteroq.service <<'EOF'
[Unit]
Description=Pterodactyl Queue Worker
After=redis-server.service
Requires=redis-server.service

[Service]
User=www-data
Group=www-data
Restart=always
ExecStart=/usr/bin/php /var/www/pterodactyl/artisan queue:work --queue=high,standard,low --sleep=3 --tries=3
StartLimitInterval=180
StartLimitBurst=30
RestartSec=5s

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable --now pteroq

    echo
    info "Creating Nginx configuration..."

    cat > /etc/nginx/sites-available/pterodactyl.conf <<EOF
server {
    listen 80;
    server_name ${PANEL_DOMAIN};

    root /var/www/pterodactyl/public;

    index index.php;

    client_max_body_size 100m;

    location / {
        try_files \$uri \$uri/ /index.php?\$query_string;
    }

    location ~ \.php$ {
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param PHP_VALUE "upload_max_filesize=100M \n post_max_size=100M";
        fastcgi_param SCRIPT_FILENAME \$document_root\$fastcgi_script_name;
        fastcgi_param HTTP_PROXY "";
        fastcgi_intercept_errors off;
        fastcgi_buffer_size 16k;
        fastcgi_buffers 4 16k;
        fastcgi_connect_timeout 300;
        fastcgi_send_timeout 300;
        fastcgi_read_timeout 300;
    }

    location ~ /\.ht {
        deny all;
    }
}
EOF

    rm -f /etc/nginx/sites-enabled/default
    ln -sf /etc/nginx/sites-available/pterodactyl.conf \
        /etc/nginx/sites-enabled/pterodactyl.conf

    echo
    info "Testing Nginx configuration..."

    if ! nginx -t; then
        error_msg "Installation failed"
        echo "Reason: Nginx configuration test failed."
        pause
        return
    fi

    systemctl reload nginx

    echo
    info "Creating first Pterodactyl administrator..."
    echo

    if ! php artisan p:user:make; then
        error_msg "Administrator creation failed."
        echo "The Panel itself was installed, but the first admin user was not created."
        pause
        return
    fi

    echo
    info "Running service checks..."

    local failed=0

    systemctl is-active --quiet nginx || failed=1
    systemctl is-active --quiet mariadb || failed=1
    systemctl is-active --quiet redis-server || failed=1
    systemctl is-active --quiet php8.3-fpm || failed=1
    systemctl is-active --quiet pteroq || failed=1

    if [[ ! -f /var/www/pterodactyl/.env ]]; then
        failed=1
    fi

    if (( failed != 0 )); then
        error_msg "Installation completed with service errors."
        echo "Check the services before using the Panel."
        pause
        return
    fi

    local SERVER_IP
    SERVER_IP="$(hostname -I 2>/dev/null | awk '{print $1}')"

    echo
    success "Installation completed successfully."
    echo
    echo -e "${WHITE}Panel URL:${RESET} http://${PANEL_DOMAIN}"
    echo -e "${WHITE}Server IP:${RESET} ${SERVER_IP:-Unknown}"
    echo
    warning "HTTPS is not configured by this installer."
    warning "If using Cloudflare, configure your Cloudflare hostname separately."
    echo
    success "Pterodactyl Panel is ready."

    pause
}

