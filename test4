delete_user() {
    clear_screen
    get_title
    echo -e "${WHITE}║${RESET}                      🗑️  DELETE USER                     ${WHITE}║${RESET}"
    echo -e "${BLUE}╚══════════════════════════════════════════════════════════════╝${RESET}"
    echo

    if [[ ! -f /var/www/pterodactyl/artisan ]]; then
        error_msg "Pterodactyl Panel is not installed."
        pause
        return
    fi

    read -rp "Enter user ID: " USER_ID

    if ! [[ "$USER_ID" =~ ^[0-9]+$ ]]; then
        error_msg "Invalid user ID."
        pause
        return
    fi

    echo
    warning "You are about to delete user ID ${USER_ID}."
    read -rp "Type DELETE to continue: " CONFIRM

    if [[ "$CONFIRM" != "DELETE" ]]; then
        info "Cancelled."
        pause
        return
    fi

    cd /var/www/pterodactyl || return

    php artisan tinker --execute="
\$user = App\Models\User::find(${USER_ID});
if (\$user) {
    \$user->delete();
    echo 'User deleted successfully.' . PHP_EOL;
} else {
    echo 'User not found.' . PHP_EOL;
}
"

    pause
}

